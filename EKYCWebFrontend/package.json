{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "ajv": "8.12.0",
    "ajv-keywords": "5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.2",
    "react-scripts": "^5.0.1",
    "schema-utils": "3.3.0"
  },
  "scripts": {
    "start": "cross-env PORT=3000 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:e2e": "cross-env CYPRESS_BASE_URL=http://localhost:3000 cypress open --e2e",
    "test:e2e:headless": "start-server-and-test \"cross-env PORT=3200 react-scripts start\" http://localhost:3200 \"cross-env CYPRESS_BASE_URL=http://localhost:3200 cypress run --browser electron --headless --e2e\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "cypress": "^13.13.1",
    "start-server-and-test": "^2.0.3",
    "typescript": "^4.9.5"
  },
  "overrides": {
    "ajv": "8.12.0",
    "ajv-keywords": "5.1.0",
    "schema-utils": "3.3.0"
  }
}
